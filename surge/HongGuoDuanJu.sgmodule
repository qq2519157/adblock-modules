#!name=红果短剧
#!desc=拦截穿山甲广告SDK、剧集间贴片、开屏素材包、埋点上报与电商推广位；保留正片/封面/登录/评论/推送。装后需清除红果缓存或重装App才会完全生效！
#!author=logan
#!category=去广告
#!homepage=https://github.com/qq2519157/adblock-modules
#!raw-url=https://raw.githubusercontent.com/qq2519157/adblock-modules/main/surge/HongGuoDuanJu.sgmodule
#!date=2026-10-25
#
# 规则来源（均已逐条核对原始文件，2026-10-25）：
#   laincat/Rules HongGuo.sgmodule（正片 DIRECT 白名单设计）
#   k6nfmm7dbr-commits/hongguo-lite 基础版/Plus 版（Map Local 空响应）
#   bluee1111/egern-hongguo-adblock（ads*-normal 正则形态）
#   doovvip HongGuo-Surge-Native V1.1.0（2026-08-31 实机验证）
#   abclq/home-dns-adblock（安卓无root实抓558域回测）
#   fmz200/wool_scripts FanQieNovel（番茄系通用拦截面）
# 实测校准：iPad版(无广告)仍请求 ads3-normal-hl.zijieapi.com，证实无广告=服务端按设备
# 不填充，域名层拦截路线正确；iOS 实测机房变体 -hl/-lf 均出现，通配已覆盖。
#
# ⚠️ 重要：本模块 [Rule] 会合入主配置规则列表，需排在更宽泛的 snssdk.com / zijieapi.com
#    直连规则之前才会生效（Surge 自上而下首条命中）。
# ⚠️ 红果是「免费看剧+广告」模式，拦截后「看广告得金币/解锁」入口可能只等待不解锁
#    （官方已公告 2026-12-31 前全面下线金币功能，该影响即将消失）。

[Rule]
# ── 正片保护：必须在本模块所有 REJECT 之前，拦截会导致黑屏/封面缺失 ─────────
# 短剧正片与听书音频 CDN
DOMAIN-SUFFIX,fqnovelvod.com,DIRECT
DOMAIN-WILDCARD,v*-reading-video*.qznovelvod.com,DIRECT
DOMAIN-WILDCARD,v*-reading-videocdn*.qznovelvod.com,DIRECT
DOMAIN,n98-v-readingvideo.qznovelvod.com,DIRECT
DOMAIN-WILDCARD,*-fq-tts.fqnovelvod.com,DIRECT
# 漫剧/小说封面图床（含正片签名 p*-novel-sign，绝不能拦）
DOMAIN-WILDCARD,p*-novel*.byteimg.com,DIRECT
# 抖音商城图与正片缩略图（laincat 实测放行；p6/p9-ad-sign 仍会被下方规则拦截）
DOMAIN,p3-ad-sign.byteimg.com,DIRECT
DOMAIN,p3-tt.byteimg.com,DIRECT
# 核心 API：内容/风控/登录/评论（api5-normal-sinfonlineb 等机房变体一并放行）
DOMAIN-WILDCARD,api*-normal.fqnovel.com,DIRECT
DOMAIN-WILDCARD,api*-normal-*.fqnovel.com,DIRECT
DOMAIN-WILDCARD,frontier*-toutiao-lq.fqnovel.com,DIRECT
# 静态图片/阅读资源
DOMAIN-WILDCARD,lf*-reading.fqnovelstatic.com,DIRECT
DOMAIN-WILDCARD,lf*-reading*.fqnovelpic.com,DIRECT
# 红果官网与抖音内嵌页
DOMAIN-SUFFIX,hongguo.com,DIRECT
DOMAIN-SUFFIX,hongguo.douyin.com,DIRECT

# ── 穿山甲 / Pangle 广告 SDK（广告请求与素材核心域）────────────────────────
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,ad.pangle.cn,REJECT
DOMAIN-SUFFIX,ad.pangolin.cn,REJECT

# ── 红果/番茄系广告投放接口（只拦 ads*-normal 子域，覆盖 -hl/-lf/-lq 机房；
#    绝不能扩大到整域 zijieapi.com，会误杀正常接口与小游戏）──────────────────
DOMAIN-WILDCARD,ads*-normal.zijieapi.com,REJECT
DOMAIN-WILDCARD,ads*-normal-*.zijieapi.com,REJECT
# 小游戏推广入口（想保留红果小游戏就注释这两行）
DOMAIN-WILDCARD,minigame*-normal.zijieapi.com,REJECT
DOMAIN-WILDCARD,minigame*-normal-*.zijieapi.com,REJECT

# ── 广告素材签名图床（p3 已在上方放行，此处实际拦 p6/p9 等）──────────────────
DOMAIN-WILDCARD,p*-ad-sign.byteimg.com,REJECT
DOMAIN,p3-mgsdk-sign.byteimg.com,REJECT
DOMAIN,p9-mgsdk-sign.byteimg.com,REJECT
DOMAIN,p1-luckycatopen.byteimg.com,REJECT
DOMAIN-WILDCARD,p*-developer-sign.bytemaimg.com,REJECT

# ── 剧集间贴片/插屏广告视频 CDN（只拦 reading-ad；正片 reading-video 已在上方放行）
DOMAIN-WILDCARD,v*-reading-ad.qznovelvod.com,REJECT
DOMAIN-WILDCARD,v*-bd-daily-reading-ad.qznovelvod.com,REJECT
DOMAIN-WILDCARD,v*-se-daily-reading-ad.qznovelvod.com,REJECT
DOMAIN-WILDCARD,v*-se-sjy-daily-reading-ad.qznovelvod.com,REJECT
# 正片 CDN 兜底直连：必须放在 reading-ad 拦截之后，否则遮蔽上方广告规则
DOMAIN-SUFFIX,qznovelvod.com,DIRECT

# ── 广告/运营配置下发（TNC 心跳与配置；番茄系多源印证）──────────────────────
DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT
DOMAIN,tnc3-aliec2.zijieapi.com,REJECT
DOMAIN,tnc0-alisc1.zijieapi.com,REJECT
DOMAIN,tnc0-aliec2.zijieapi.com,REJECT

# ── 广告弹窗 / 跳转 / 落地页 ────────────────────────────────────────────────
DOMAIN,zlink.ugsdk.cn,REJECT
DOMAIN-SUFFIX,praisewindow.ugsdk.cn,REJECT
DOMAIN,praisewindow-sinfonlinea.ugsdk.cn,REJECT
DOMAIN-SUFFIX,chengzijianzhan.com,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT
DOMAIN,dig.bdurl.net,REJECT

# ── 电商推广位（想用红果内置商城就注释这一段）──────────────────────────────
DOMAIN-WILDCARD,ecom*-normal*.ecombdapi.com,REJECT
DOMAIN-WILDCARD,ec*-core*.ecombdapi.com,REJECT
DOMAIN-WILDCARD,isaas*-normal*.ecombdapi.com,REJECT

# ── 随机子域广告 CDN（安卓无root实抓确认的伪装域名，iOS 侧待观察）───────────
DOMAIN-SUFFIX,comfylink.com,REJECT
DOMAIN-SUFFIX,ndcpp.com,REJECT
DOMAIN-SUFFIX,ydycdn.com,REJECT
DOMAIN-SUFFIX,qrstuvwxyzab.com,REJECT
DOMAIN-SUFFIX,wuchuyun.com,REJECT
DOMAIN-SUFFIX,xinqiucc.com,REJECT
DOMAIN-SUFFIX,jomoxc.com,REJECT
DOMAIN-SUFFIX,wmzfylgdsz.com,REJECT

# ── 埋点 / 上报（不影响播放；App 功能异常时先注释 i*.snssdk.com 这几行）─────
DOMAIN,mon.toutiaocloud.net,REJECT
DOMAIN,mon.toutiaocloud.com,REJECT
DOMAIN,mon.zijieapi.com,REJECT
DOMAIN,applog.zijieapi.com,REJECT
DOMAIN,i.snssdk.com,REJECT
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,i-hl.snssdk.com,REJECT
DOMAIN,ib-lq.snssdk.com,REJECT
DOMAIN-KEYWORD,applog.fqnovel.com,REJECT
DOMAIN-KEYWORD,-misc.fqnovel.com,REJECT
DOMAIN-WILDCARD,rtlog*-applog-lq.fqnovel.com,REJECT
# is.snssdk.com 是否拦截两派说法不一（有实测称是设备注册风控域），默认放行观察：
#DOMAIN,is.snssdk.com,REJECT
#DOMAIN,is-lq.snssdk.com,REJECT

# ── 红果专属域名（单一来源未实证，待实抓确认后启用）─────────────────────────
#DOMAIN-SUFFIX,hongguoapp.com,REJECT
#DOMAIN-SUFFIX,hongguosdk.com,REJECT

[URL Rewrite]
# 开屏/活动素材包下发（番茄系社区多源印证）
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package - reject
# 广告安装包/渲染图（与正常内容共用图片CDN，默认关闭：解密主图床CPU开销大，想开需把
# *.pstatp.com *.byteimg.com 加入下方 MITM）
#^https?:\/\/[^\/]+\.byteimg\.com\/(ad-app-package|web\.business\.image) - reject
#^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)\/ - reject

[Map Local]
# 广告请求接口返回空 JSON：reject 断连会被 SDK 当网络错误反复重试，返回合法空响应更干净。
# 注：若上方 [Rule] 已 REJECT 对应域名，这里不会触发；两段互为兜底（域名段被注释时由此接手）
^https://[^/]*pangolin-sdk-toutiao[^/]*/api/ad/union/sdk/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://[^/]*\.snssdk\.com/api/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
# ⚠️ 若红果出现打不开/一直转圈 = 命中证书固定(pinning)，先删 *.snssdk.com 这一项；
#    仍不行就删掉整个 [MITM] 段退回纯域名版（纯域名版已能拦掉大头）
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, gurd.snssdk.com, *.snssdk.com
