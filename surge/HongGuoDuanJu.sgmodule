#!name=红果短剧
#!desc=拦截穿山甲广告SDK、直播带货卡片（信令+拉流）、剧集间贴片、开屏素材包、埋点上报与电商推广位；保留正片/封面/登录/评论/推送。装后需清除红果缓存或重装App才会完全生效！
#!author=logan
#!category=去广告
#!homepage=https://github.com/qq2519157/adblock-modules
#!raw-url=https://raw.githubusercontent.com/qq2519157/adblock-modules/main/surge/HongGuoDuanJu.sgmodule
#!date=2026-10-26
#
# v1.2 (2026-10-26)：
#   1. 全量补 extended-matching（官方参数，同时匹配 TLS SNI 与 HTTP Host 头，专治
#      「App 自带 HTTPDNS 直连裸 IP、域名只出现在 SNI」——红果正是此场景，v1.1 全漏）
#   2. 新增 [Host] DNS 黑洞：本地权威应答 127.0.0.1，先于规则引擎、不受主配置
#      DOMAIN-SET 压制（manual.nssurge.com/dns/local-dns-mapping.html）
#   3. 新增直播拉流 kill：直播广告的音视频走「裸IP+明文HTTP+域名藏路径」
#      （实测 http://IP/pull-flv-h1.douyincdn.com/third/stream-*.flv），域名规则看不见，
#      [URL Rewrite] 先于规则引擎求值，专杀此暗道
#   4. 新增 DOMAIN-KEYWORD,httpdns 断 DNS 旁路（Kelee Block_HTTPDNS 先例），
#      逼 App 回退系统 DNS，让域名规则与 [Host] 生效
#   5. 新增白山云节点 v9-default.tt.x.bsgslb.cn 试验拦截（广告素材嫌疑，正片异常即删此行）
#   注：pre-matching（iOS 5.14+）与 extended-matching（iOS 5.8+）可同写一行；
#       旧版本对未知参数「静默忽略」不报错（manual.nssurge.com/rules/overview.html）
#
# v1.1：直播信令域 webcast*-open*/content-open/pangolin*.snssdk + pre-matching + 信封脚本
# v1.0：域名层（laincat/k6nfmm7dbr/bluee1111/doovvip/abclq 六源融合）
#
# ⚠️ 红果是「免费看剧+广告」模式，拦截后激励类入口可能只等待不解锁（金币功能官方
#    已公告 2026-12-31 前全面下线，影响将自动消失）。
# ⚠️ 本模块会拦截设备上所有字节系 App 的穿山甲广告（域名全局生效，属预期）。

[Rule]
# ── 正片保护：必须在本模块所有 REJECT 之前；extended-matching 保证裸 IP(SNI) 连接下
#    白名单仍然生效（否则下方 REJECT 补齐 SNI 匹配后，正片裸 IP 连接会掉进主配置规则）
DOMAIN-SUFFIX,fqnovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,v*-reading-video*.qznovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,v*-reading-videocdn*.qznovelvod.com,DIRECT,extended-matching
DOMAIN,n98-v-readingvideo.qznovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,*-fq-tts.fqnovelvod.com,DIRECT,extended-matching
DOMAIN-WILDCARD,p*-novel*.byteimg.com,DIRECT,extended-matching
DOMAIN,p3-ad-sign.byteimg.com,DIRECT,extended-matching
DOMAIN,p3-tt.byteimg.com,DIRECT,extended-matching
DOMAIN-WILDCARD,api*-normal.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,api*-normal-*.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,frontier*-toutiao-lq.fqnovel.com,DIRECT,extended-matching
DOMAIN-WILDCARD,lf*-reading.fqnovelstatic.com,DIRECT,extended-matching
DOMAIN-WILDCARD,lf*-reading*.fqnovelpic.com,DIRECT,extended-matching
DOMAIN-SUFFIX,hongguo.com,DIRECT,extended-matching
DOMAIN-SUFFIX,hongguo.douyin.com,DIRECT,extended-matching

# ── 断 HTTPDNS 旁路：逼 App 回退系统 DNS，本模块域名规则与 [Host] 才有机会生效 ──
DOMAIN-KEYWORD,httpdns,REJECT,extended-matching,pre-matching

# ── 直播带货卡片信令（直播间开放接口=卡片数据源；用户实抓+四独立上游印证）────
DOMAIN-WILDCARD,webcast*-open*.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,webcast*-open*.douyin.com.c.dsa.cdnbuild.net,REJECT,extended-matching,pre-matching
DOMAIN,content-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,pangolin*.snssdk.com,REJECT,extended-matching,pre-matching
# ── 勿拦（多源实测误伤）：p*-webcast*.douyinpic.com=封面白屏；pull-lls-*=推送共用；
#     webcast5-ws-web-*=真直播弹幕WS；douyinpic.com/ecombdimg.com=通用图床；
#     bytegecko.com=H5离线包；pitaya.bytedance.com=播放器配置 ──
#DOMAIN,webcast.amemv.com,REJECT,extended-matching,pre-matching
#DOMAIN,lf6-webcastcdn-tos-sign.douyinstatic.com,REJECT,extended-matching,pre-matching

# ── 穿山甲 / Pangle 广告 SDK ────────────────────────────────────────────────
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.pangle.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.pangolin.cn,REJECT,extended-matching,pre-matching

# ── 红果/番茄系广告投放接口（只拦 ads*-normal 子域，-hl/-lf/-lq 机房全覆盖）────
DOMAIN-WILDCARD,ads*-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,ads*-normal-*.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,minigame*-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,minigame*-normal-*.zijieapi.com,REJECT,extended-matching,pre-matching

# ── 广告素材签名图床（普通阶段：p3 已在上方 DIRECT 放行；不加 pre-matching 以免
#    压掉 p3-ad-sign/p3-tt 的 DIRECT 例外）─────────────────────────────────────
DOMAIN-WILDCARD,p*-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p3-mgsdk-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p9-mgsdk-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p1-luckycatopen.byteimg.com,REJECT,extended-matching
DOMAIN-WILDCARD,p*-developer-sign.bytemaimg.com,REJECT,extended-matching

# ── 剧集间贴片/插屏广告视频 CDN（只拦 reading-ad；正片 reading-video 已在上方放行）
DOMAIN-WILDCARD,v*-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-bd-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-se-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,v*-se-sjy-daily-reading-ad.qznovelvod.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,qznovelvod.com,DIRECT,extended-matching

# ── 广告/运营配置下发（TNC）────────────────────────────────────────────────
DOMAIN,tnc3-alisc1.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-aliec2.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc3-aliec2.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc0-alisc1.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,tnc0-aliec2.zijieapi.com,REJECT,extended-matching,pre-matching

# ── 广告弹窗 / 跳转 / 落地页（均有证书固定，域名层 REJECT 不受 pinning 影响）────
DOMAIN,zlink.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,praisewindow.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN,praisewindow-sinfonlinea.ugsdk.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,chengzijianzhan.com,REJECT,extended-matching,pre-matching
DOMAIN,activity-ag.awemeughun.com,REJECT,extended-matching,pre-matching
DOMAIN,dig.bdurl.net,REJECT,extended-matching,pre-matching

# ── 电商推广位（想用红果内置商城就注释这一段）──────────────────────────────
DOMAIN-WILDCARD,ecom*-normal*.ecombdapi.com,REJECT,extended-matching
DOMAIN-WILDCARD,ec*-core*.ecombdapi.com,REJECT,extended-matching
DOMAIN-WILDCARD,isaas*-normal*.ecombdapi.com,REJECT,extended-matching

# ── 随机子域广告 CDN（安卓实抓确认的伪装域名）──────────────────────────────
DOMAIN-SUFFIX,comfylink.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ndcpp.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ydycdn.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,qrstuvwxyzab.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,wuchuyun.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,xinqiucc.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,jomoxc.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,wmzfylgdsz.com,REJECT,extended-matching,pre-matching

# ── 白山云字节节点（试验位：广告素材嫌疑；正片播放异常就删掉这一行）──────────
DOMAIN,v9-default.tt.x.bsgslb.cn,REJECT,extended-matching,pre-matching

# ── 埋点 / 上报（不影响播放；App 功能异常时先注释 i*.snssdk.com 这几行）─────
DOMAIN,mon.toutiaocloud.net,REJECT,extended-matching,pre-matching
DOMAIN,mon.toutiaocloud.com,REJECT,extended-matching,pre-matching
DOMAIN,mon.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,applog.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,i.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,i-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,i-hl.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,ib-lq.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,applog.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,-misc.fqnovel.com,REJECT,extended-matching,pre-matching
DOMAIN-WILDCARD,rtlog*-applog-lq.fqnovel.com,REJECT,extended-matching,pre-matching
# is.snssdk.com 故意放行：交给下方脚本返回无填充信封（断连会触发 SDK 重试）
#DOMAIN,is.snssdk.com,REJECT
#DOMAIN,is-lq.snssdk.com,REJECT
#DOMAIN-SUFFIX,hongguoapp.com,REJECT
#DOMAIN-SUFFIX,hongguosdk.com,REJECT

[URL Rewrite]
# ── 直播广告拉流 kill（v1.2 核心新增，v1.2.1 修双形态）────────────────────────
# 实测广告流有两种形态，杀一条它会立刻换另一条重试：
#   A. 裸 IP + 域名藏路径：http://<IP>/pull-flv-h1.douyincdn.com/third/stream-*.flv
#   B. 域名直连：http://pull-flv-q1.douyincdn.com/third/stream-*.flv
# 正则的 (?:[^\/]+\/)? 同时覆盖 A/B；URL Rewrite 在 HTTP 层求值、先于规则引擎，
# 不受任何规则集压制。只杀 /third/ 第三方流，保抖音正常直播。
^https?:\/\/(?:[^\/]+\/)?pull-flv-[^\/]*\.douyincdn\.com\/third\/ - reject
# 升级位（广告改走非 third 路径或 HLS 时逐条启用；全开会影响本机所有抖音系直播观看）：
#^https?:\/\/(?:[^\/]+\/)?pull-flv-[^\/]*\.douyincdn\.com\/ - reject
#^https?:\/\/(?:[^\/]+\/)?pull-hls-[^\/]*\.douyincdn\.com\/ - reject
# 开屏/活动素材包下发
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package - reject

[Host]
# DNS 黑洞：本地权威应答 127.0.0.1（无监听即拒连），先于规则引擎、不受主配置
# DOMAIN-SET 压制。注意 [Host] 通配 * 跨横杠/点均合法；*foo.com 才能覆盖裸域+全部子域。
# 局限：App 走自带 HTTPDNS 裸 IP 时不经系统 DNS，本段对其无效（由上方
# REJECT,extended-matching 按 SNI 兜住 + httpdns 关键字断其旁路）。
ads*-normal.zijieapi.com = 127.0.0.1
ads*-normal-*.zijieapi.com = 127.0.0.1
minigame*-normal.zijieapi.com = 127.0.0.1
minigame*-normal-*.zijieapi.com = 127.0.0.1
webcast-open.douyin.com = 127.0.0.1
webcast*-open*.douyin.com = 127.0.0.1
webcast*-open*.douyin.com.c.dsa.cdnbuild.net = 127.0.0.1
content-open.douyin.com = 127.0.0.1
pangolin*.snssdk.com = 127.0.0.1
*pangolin-sdk-toutiao.com = 127.0.0.1
*pangolin-sdk-toutiao1.com = 127.0.0.1
*pangolin-sdk-toutiao-b.com = 127.0.0.1
*pglstatp-toutiao.com = 127.0.0.1
*pglstatp-toutiao-b.com = 127.0.0.1
*pangle.io = 127.0.0.1
v*-reading-ad.qznovelvod.com = 127.0.0.1
v*-bd-daily-reading-ad.qznovelvod.com = 127.0.0.1
v*-se-daily-reading-ad.qznovelvod.com = 127.0.0.1
v*-se-sjy-daily-reading-ad.qznovelvod.com = 127.0.0.1
tnc3-alisc1.snssdk.com = 127.0.0.1
tnc3-aliec2.snssdk.com = 127.0.0.1
tnc3-alisc1.zijieapi.com = 127.0.0.1
tnc3-aliec2.zijieapi.com = 127.0.0.1
tnc0-alisc1.zijieapi.com = 127.0.0.1
tnc0-aliec2.zijieapi.com = 127.0.0.1
zlink.ugsdk.cn = 127.0.0.1
*praisewindow.ugsdk.cn = 127.0.0.1
*chengzijianzhan.com = 127.0.0.1
activity-ag.awemeughun.com = 127.0.0.1
dig.bdurl.net = 127.0.0.1
mon.toutiaocloud.net = 127.0.0.1
mon.toutiaocloud.com = 127.0.0.1
mon.zijieapi.com = 127.0.0.1
applog.zijieapi.com = 127.0.0.1
i.snssdk.com = 127.0.0.1
i-lq.snssdk.com = 127.0.0.1
i-hl.snssdk.com = 127.0.0.1
ib-lq.snssdk.com = 127.0.0.1
v9-default.tt.x.bsgslb.cn = 127.0.0.1
*comfylink.com = 127.0.0.1
*ndcpp.com = 127.0.0.1
*ydycdn.com = 127.0.0.1
*qrstuvwxyzab.com = 127.0.0.1
*wuchuyun.com = 127.0.0.1
*xinqiucc.com = 127.0.0.1
*jomoxc.com = 127.0.0.1
*wmzfylgdsz.com = 127.0.0.1
# 勿入黑洞：-ad-sign 族（p3-ad-sign 白名单无法在 [Host] 表达例外）、ecombdapi（商城可关）、
# 全部 fqnovel/fqnovelvod/byteimg/douyinpic 正片与图床域

[Script]
# 穿山甲 get_ads「无填充」信封（官方错误码 20001/reason 112）
# 脚本（本仓库 scripts/hongguo_ads.js，改编自 app2smile/rules adsense.js 穿山甲分支）
HongGuo_AdEnvelope = type=http-response, pattern=^https?:\/\/(?:[^\/]*pangolin-sdk-toutiao[^\/]*|is\.snssdk\.com)\/api\/ad\/, requires-body=true, script-path=https://raw.githubusercontent.com/qq2519157/adblock-modules/main/scripts/hongguo_ads.js, script-update-interval=86400

[MITM]
# ⚠️ 若红果打不开/一直转圈：先删 *.snssdk.com；再不行删掉整个 [MITM] 段退回纯域名版
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, gurd.snssdk.com, is.snssdk.com, *.snssdk.com
