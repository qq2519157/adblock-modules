#!name=红果短剧
#!desc=拦截穿山甲广告SDK、直播带货卡片信令、剧集间贴片、开屏素材包、埋点上报与电商推广位；保留正片/封面/登录/评论/推送。装后需清除红果缓存或重装App才会完全生效！
#!author=logan
#!category=去广告
#!homepage=https://github.com/qq2519157/adblock-modules
#!raw-url=https://raw.githubusercontent.com/qq2519157/adblock-modules/main/surge/HongGuoDuanJu.sgmodule
#!date=2026-10-26
#
# v1.1 (2026-10-26)：
#   1. REJECT 加 pre-matching（DNS/TCP 阶段求值，优先于一切普通规则）——修复被主配置
#      更宽的 snssdk/zijieapi/douyin 直连规则压住导致 ads3 走 DIRECT 的问题
#   2. 新增直播带货卡片信令域：webcast*-open*.douyin.com / content-open.douyin.com /
#      pangolin*.snssdk.com（用户实机抓包定位 + 四个独立上游印证）
#   3. 删除 Map Local "{}" 空响应（缺 status_code，SDK 视为解析错误→反复重试），
#      改用 app2smile adsense.js 的穿山甲官方无填充信封（status_code=20001）
#   4. 证书固定域（ecombdapi/ads*/ugsdk/ad-sign 等）只走域名层 REJECT——REJECT 在
#      TLS 握手前断连，不受 pinning 影响；不再对它们做任何 MITM 依赖
#
# 规则来源（已逐条核对原始文件）：
#   laincat/Rules · k6nfmm7dbr-commits/hongguo-lite · bluee1111/egern-hongguo-adblock
#   doovvip HongGuo-Surge-Native V1.1.0 · abclq/home-dns-adblock（安卓实抓558域回测）
#   anpplex/Surge fanqie.sgmodule · fmz200/wool_scripts · app2smile/rules adsense.js
# 实测校准：iPad(无广告)仍请求 ads3-normal-hl（服务端按设备不填充）；直播卡片会话指纹
# =webcast3/5-open-hl.douyin.com + content-open.douyin.com + isaas*-hl.ecombdapi.com ×10。
#
# ⚠️ 红果是「免费看剧+广告」模式，拦截后激励类入口可能只等待不解锁（金币功能官方
#    已公告 2026-12-31 前全面下线，影响将自动消失）。

[Rule]
# ── 正片保护：必须在本模块所有普通阶段 REJECT 之前（pre-matching 规则不受此约束，
#    但其 pattern 均不与以下白名单重叠）────────────────────────────────────────
# 短剧正片与听书音频 CDN
DOMAIN-SUFFIX,fqnovelvod.com,DIRECT
DOMAIN-WILDCARD,v*-reading-video*.qznovelvod.com,DIRECT
DOMAIN-WILDCARD,v*-reading-videocdn*.qznovelvod.com,DIRECT
DOMAIN,n98-v-readingvideo.qznovelvod.com,DIRECT
DOMAIN-WILDCARD,*-fq-tts.fqnovelvod.com,DIRECT
# 漫剧/小说封面图床（含正片签名 p*-novel-sign，绝不能拦）
DOMAIN-WILDCARD,p*-novel*.byteimg.com,DIRECT
# 抖音商城图与正片缩略图（laincat 实测放行；p6/p9-ad-sign 仍会被下方规则拦截）
DOMAIN,p3-ad-sign.byteimg.com,DIRECT
DOMAIN,p3-tt.byteimg.com,DIRECT
# 核心 API：内容/风控/登录/评论（api5-normal-sinfonlineb 等机房变体一并放行）
DOMAIN-WILDCARD,api*-normal.fqnovel.com,DIRECT
DOMAIN-WILDCARD,api*-normal-*.fqnovel.com,DIRECT
DOMAIN-WILDCARD,frontier*-toutiao-lq.fqnovel.com,DIRECT
# 静态图片/阅读资源
DOMAIN-WILDCARD,lf*-reading.fqnovelstatic.com,DIRECT
DOMAIN-WILDCARD,lf*-reading*.fqnovelpic.com,DIRECT
# 红果官网与抖音内嵌页
DOMAIN-SUFFIX,hongguo.com,DIRECT
DOMAIN-SUFFIX,hongguo.douyin.com,DIRECT

# ── 直播带货卡片信令（v1.1 新增主力：断直播间数据供给，卡片无从渲染）────────
# 直播间开放接口（房间信息/卡片自渲染数据源），用户实抓 + abclq/CLQ_Shield/gitlawyercan/anpplex 四源在拦
# 注：会把红果内跳转真实直播间一并断掉（那正是广告落地页，属预期）
DOMAIN-WILDCARD,webcast*-open*.douyin.com,REJECT,pre-matching
DOMAIN,webcast-open.douyin.com,REJECT,pre-matching
# CNAME 真身（abclq 实测：只封表层域后 App 会直连此真身绕过）
DOMAIN-WILDCARD,webcast*-open*.douyin.com.c.dsa.cdnbuild.net,REJECT,pre-matching
# 抖音直播内容开放接口（与 webcast-open 同族）
DOMAIN,content-open.douyin.com,REJECT,pre-matching
# 穿山甲在 snssdk 上的承载域（v2fly domain-list @ads 分组四条）
DOMAIN-WILDCARD,pangolin*.snssdk.com,REJECT,pre-matching
# ── 勿拦（多源实测误伤）：p*-webcast.douyinpic.com=封面白屏；pull-lls-*.douyincdn.com=
# 直播拉流+推送共用；webcast5-ws-web-*.douyin.com=真直播弹幕WS；douyinpic.com/ecombdimg.com=
# 通用图床；bytegecko.com=H5离线包；pitaya.bytedance.com=播放器配置 ──
# 可选（实抓出现过一次，复现再启用）：
#DOMAIN,webcast.amemv.com,REJECT,pre-matching
#DOMAIN,lf6-webcastcdn-tos-sign.douyinstatic.com,REJECT,pre-matching

# ── 穿山甲 / Pangle 广告 SDK（广告请求与素材核心域）────────────────────────
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,pre-matching
DOMAIN-SUFFIX,ad.pangle.cn,REJECT,pre-matching
DOMAIN-SUFFIX,ad.pangolin.cn,REJECT,pre-matching

# ── 红果/番茄系广告投放接口（只拦 ads*-normal 子域，覆盖 -hl/-lf/-lq 机房）────
DOMAIN-WILDCARD,ads*-normal.zijieapi.com,REJECT,pre-matching
DOMAIN-WILDCARD,ads*-normal-*.zijieapi.com,REJECT,pre-matching
# 小游戏推广入口（想保留红果小游戏就注释这两行）
DOMAIN-WILDCARD,minigame*-normal.zijieapi.com,REJECT,pre-matching
DOMAIN-WILDCARD,minigame*-normal-*.zijieapi.com,REJECT,pre-matching

# ── 广告素材签名图床（普通阶段：p3 已在上方 DIRECT 放行，此处实际拦 p6/p9；
#    故意不加 pre-matching，避免压掉 p3-ad-sign/p3-tt 的 DIRECT 例外）──────────
DOMAIN-WILDCARD,p*-ad-sign.byteimg.com,REJECT
DOMAIN,p3-mgsdk-sign.byteimg.com,REJECT
DOMAIN,p9-mgsdk-sign.byteimg.com,REJECT
DOMAIN,p1-luckycatopen.byteimg.com,REJECT
DOMAIN-WILDCARD,p*-developer-sign.bytemaimg.com,REJECT

# ── 剧集间贴片/插屏广告视频 CDN（只拦 reading-ad；正片 reading-video 已在上方放行）
DOMAIN-WILDCARD,v*-reading-ad.qznovelvod.com,REJECT,pre-matching
DOMAIN-WILDCARD,v*-bd-daily-reading-ad.qznovelvod.com,REJECT,pre-matching
DOMAIN-WILDCARD,v*-se-daily-reading-ad.qznovelvod.com,REJECT,pre-matching
DOMAIN-WILDCARD,v*-se-sjy-daily-reading-ad.qznovelvod.com,REJECT,pre-matching
# 正片 CDN 兜底直连：普通阶段兜底，必须放在 reading-ad 拦截之后
DOMAIN-SUFFIX,qznovelvod.com,DIRECT

# ── 广告/运营配置下发（TNC 心跳与配置；番茄系多源印证）──────────────────────
DOMAIN,tnc3-alisc1.snssdk.com,REJECT,pre-matching
DOMAIN,tnc3-aliec2.snssdk.com,REJECT,pre-matching
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT,pre-matching
DOMAIN,tnc3-aliec2.zijieapi.com,REJECT,pre-matching
DOMAIN,tnc0-alisc1.zijieapi.com,REJECT,pre-matching
DOMAIN,tnc0-aliec2.zijieapi.com,REJECT,pre-matching

# ── 广告弹窗 / 跳转 / 落地页（gitlawyercan 实测此组均有证书固定，域名层 REJECT
#    在 TLS 握手前断连，不受 pinning 影响）────────────────────────────────────
DOMAIN,zlink.ugsdk.cn,REJECT,pre-matching
DOMAIN-SUFFIX,praisewindow.ugsdk.cn,REJECT,pre-matching
DOMAIN,praisewindow-sinfonlinea.ugsdk.cn,REJECT,pre-matching
DOMAIN-SUFFIX,chengzijianzhan.com,REJECT,pre-matching
DOMAIN,activity-ag.awemeughun.com,REJECT,pre-matching
DOMAIN,dig.bdurl.net,REJECT,pre-matching

# ── 电商推广位（想用红果内置商城就注释这一段；有证书固定，域名层同样有效）────
DOMAIN-WILDCARD,ecom*-normal*.ecombdapi.com,REJECT
DOMAIN-WILDCARD,ec*-core*.ecombdapi.com,REJECT
DOMAIN-WILDCARD,isaas*-normal*.ecombdapi.com,REJECT

# ── 随机子域广告 CDN（安卓无root实抓确认的伪装域名）─────────────────────────
DOMAIN-SUFFIX,comfylink.com,REJECT,pre-matching
DOMAIN-SUFFIX,ndcpp.com,REJECT,pre-matching
DOMAIN-SUFFIX,ydycdn.com,REJECT,pre-matching
DOMAIN-SUFFIX,qrstuvwxyzab.com,REJECT,pre-matching
DOMAIN-SUFFIX,wuchuyun.com,REJECT,pre-matching
DOMAIN-SUFFIX,xinqiucc.com,REJECT,pre-matching
DOMAIN-SUFFIX,jomoxc.com,REJECT,pre-matching
DOMAIN-SUFFIX,wmzfylgdsz.com,REJECT,pre-matching

# ── 埋点 / 上报（不影响播放；App 功能异常时先注释 i*.snssdk.com 这几行）─────
DOMAIN,mon.toutiaocloud.net,REJECT,pre-matching
DOMAIN,mon.toutiaocloud.com,REJECT,pre-matching
DOMAIN,mon.zijieapi.com,REJECT,pre-matching
DOMAIN,applog.zijieapi.com,REJECT,pre-matching
DOMAIN,i.snssdk.com,REJECT,pre-matching
DOMAIN,i-lq.snssdk.com,REJECT,pre-matching
DOMAIN,i-hl.snssdk.com,REJECT,pre-matching
DOMAIN,ib-lq.snssdk.com,REJECT,pre-matching
DOMAIN-KEYWORD,applog.fqnovel.com,REJECT,pre-matching
DOMAIN-KEYWORD,-misc.fqnovel.com,REJECT,pre-matching
DOMAIN-WILDCARD,rtlog*-applog-lq.fqnovel.com,REJECT,pre-matching
# is.snssdk.com 故意放行（不拦）：交给下方脚本返回无填充信封（断连会触发 SDK 重试）
#DOMAIN,is.snssdk.com,REJECT
#DOMAIN,is-lq.snssdk.com,REJECT

# ── 红果专属域名（单一来源未实证，待实抓确认后启用）─────────────────────────
#DOMAIN-SUFFIX,hongguoapp.com,REJECT
#DOMAIN-SUFFIX,hongguosdk.com,REJECT

[URL Rewrite]
# 开屏/活动素材包下发（番茄系社区多源印证）
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package - reject

[Script]
# 穿山甲 get_ads「无填充」信封（官方错误码 20001/reason 112，出处 csjplatform.com/supportcenter/5421）
# v1 曾用 Map Local 返回 {}：缺 status_code，SDK 视为解析错误≈网络错误→反复重试，已废弃
# 脚本（本仓库 scripts/hongguo_ads.js，改编自 app2smile/rules adsense.js 穿山甲分支）：
# 响应含 message 字段=有广告→替换为无填充信封；已是空/无填充→原样放行。
# is.snssdk.com 保持 DIRECT 由本脚本接手
HongGuo_AdEnvelope = type=http-response, pattern=^https?:\/\/(?:[^\/]*pangolin-sdk-toutiao[^\/]*|is\.snssdk\.com)\/api\/ad\/, requires-body=true, script-path=https://raw.githubusercontent.com/qq2519157/adblock-modules/main/scripts/hongguo_ads.js, script-update-interval=86400

[MITM]
# ⚠️ 若红果打不开/一直转圈：先删 *.snssdk.com；再不行删掉整个 [MITM] 段退回纯域名版
#    （域名层含 pre-matching，已覆盖穿山甲/直播卡片/投放域大头，不依赖 MITM）
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, gurd.snssdk.com, is.snssdk.com, *.snssdk.com
# 实验分支（默认关闭）：内容 API 有证书固定风险（gitlawyercan 实测 UNKNOWN_CA），
# 开启时把 api5-normal-hl.fqnovel.com 追加到上一行 hostname 末尾（不要写第二个 hostname 行），
# 灰度序列见 docs/hongguo.md；任一异常立即删掉退回纯域名版
